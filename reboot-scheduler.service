[Unit]
Description=Daily random reboot scheduler (01:00-02:00 UTC)

[Service]
Type=simple
User=root
ExecStart=/opt/reboot-scheduler/reboot-scheduler
Restart=on-failure
RestartSec=60
StandardOutput=journal
StandardError=journal

# Basic hardening
CapabilityBoundingSet=CAP_SYS_BOOT
AmbientCapabilities=CAP_SYS_BOOT
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
